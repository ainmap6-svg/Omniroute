# Railway: volume root egaligida ulanadi, ilova UID 1000 da ishlaydi -> /data yozilmaydi.
# Bu o'zgaruvchi konteynerni root qilib ishga tushiradi (Railway rasmiy yechimi).
RAILWAY_RUN_UID=0

# Railway -> Variables (yoki Render -> Environment) ga qo'ying.
# Tasodifiy qiymat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
OMNIROUTE_WS_BRIDGE_SECRET=
# Dashboard'ga birinchi kirish paroli — CHANGEME qoldirmang
INITIAL_PASSWORD=
# Ochiq manzil, masalan https://omniroute.up.railway.app
NEXT_PUBLIC_BASE_URL=
